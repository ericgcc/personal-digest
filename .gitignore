.trash/
.obsidian/
.makemd/
.space/
.digest-runs/
# Left over from the retired JavaScript implementation; no longer referenced.
node_modules/

# Runtime state databases (preserved outside Git)
state/digest-state.db
state/*.db

# Installation-specific runtime configuration (the committed example is portable)
system/runtime.json
config/runtime.json

# Generated evaluation output (derived from .digest-runs, reproducible)
evaluation-results/
evaluation-results-*/
# Local Python environment
.venv/
venv/

# Python bytecode caches (compiled artifacts, never source)
__pycache__/
*.py[cod]

# Local secrets - never commit
.env
.env.*
!.env.example

# Offline prompt inspection output (`python -m digest_system.cli inspect`): derived,
# reproducible from the templates and profiles, never source
prompt-inspections/